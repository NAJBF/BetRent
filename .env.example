# Copy to .env and fill in real values (never commit .env)

# --- API CONFIG ---
SECRET_KEY=change-me-BetRent-local-key
DEBUG=True
ALLOWED_HOSTS=*

# --- DATABASE ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- REDIS / CACHE ---
REDIS_URL=redis://localhost:6379/1

# --- EMAIL (OTP) — Brevo + Gmail sender (works on Render) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your@gmail.com
BREVO_SENDER_NAME=BetRent

# Gmail SMTP — local dev only (blocked on Render)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=BetRent <your@gmail.com>

# Resend — optional (needs verified domain)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- EXTERNAL PAYMENT GATEWAY ---
PAYMENT_APP_TOKEN=your-static-token

# --- CHAPA PAYMENT GATEWAY ---
CHAPA_SECRET_KEY=
